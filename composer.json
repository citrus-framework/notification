{
  "name": "citrus-framework/notification",
  "description": "php notification library",
  "keywords": ["citrus", "php", "library", "notification", "discord"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "take64",
      "email": "take64@citrus.tk"
    }
  ],
  "require": {
    "php": "^8.3",
    "citrus-framework/configure": "^1.0",
    "citrus-framework/http": "^1.0.24",
    "citrus-framework/logger": "^1.0",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "nunomaduro/phpinsights": "^2.15.1"
  },
  "autoload": {
    "psr-4": {
      "Citrus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}
